{
  "name": "@lemondouble/ui",
  "version": "0.1.0",
  "description": "LemonDouble 디자인 시스템의 React 컴포넌트와 토큰",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LemonDouble/lemon-ui.git"
  },
  "homepage": "https://lemondouble.github.io/lemon-ui/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepublishOnly": "pnpm run build"
  },
  "packageManager": "pnpm@12.8.1",
  "peerDependencies": {
    "lucide-react": ">=1.0.0",
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.5"
  },
  "keywords": [
    "design-system",
    "lemondouble",
    "react",
    "tailwindcss"
  ],
  "author": "lemondouble",
  "license": "MIT"
}
